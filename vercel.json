{
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    {
      "path": "/api/v1/internal/cron/booking-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/internal/cron/refund-processor",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/v1/internal/cron/storage-sweep",
      "schedule": "30 3 * * *"
    }
  ]
}
